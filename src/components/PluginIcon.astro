---
import type { Plugin } from "@/types/plugin";
import { placeholderHue, placeholderLetter } from "@/utils/plugin";

interface Props {
  plugin: Plugin;
  size?: number;
  class?: string;
}

const { plugin, size = 40 } = Astro.props;
const hue = placeholderHue(plugin.slug);
---

{
  plugin.icon ? (
    <img
      src={plugin.icon}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      class={`shrink-0 rounded-lg object-cover ${Astro.props.class ?? ""}`}
    />
  ) : (
    <span
      class={`placeholder-icon flex shrink-0 items-center justify-center rounded-lg font-display font-semibold select-none ${Astro.props.class ?? ""}`}
      style={`--hue: ${hue}; width: ${size}px; height: ${size}px; font-size: ${Math.round(size * 0.44)}px`}
      aria-hidden="true"
    >
      {placeholderLetter(plugin)}
    </span>
  )
}
