---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { plugins } from "@/data/plugins";
import { getAllTags } from "@/utils/plugin";
import { BookOpen, Check, FolderGit2, ShieldCheck, X } from "lucide-react";

const tagCount = getAllTags(plugins).length;

const does = [
  "发现与浏览 Harness 插件",
  "按名称、描述、标签或作者搜索",
  "按标签筛选并排序目录",
  "解释每个插件的用途",
  "链接到作者的原始仓库",
  "复制安装命令，供您在终端中执行",
];

const doesNot = [
  "托管或存储插件文件",
  "下载、镜像或代理插件",
  "安装或执行任何程序",
  "管理账户或评分",
  "运行后端、数据库或 API",
];
---

<BaseLayout
  title="关于 — DeepSeek Harness插件市场"
  description="DeepSeek Harness插件市场（DSH插件市场）是一个插件目录。它展示、介绍并链接 Harness 插件——从不托管、下载或执行它们。"
>
  <PageHeader
    eyebrow="关于项目"
    title="一个克制、透明的插件目录"
    description="DSH插件市场帮助你发现插件、理解用途并找到安装方式；插件始终由原作者独立维护。"
  >
    <div class="mt-5 flex flex-wrap gap-2 font-mono text-[11px] text-muted-foreground">
      <span class="rounded-full border border-border bg-card px-3 py-1.5">{plugins.length} 个插件</span>
      <span class="rounded-full border border-border bg-card px-3 py-1.5">{tagCount} 个标签</span>
      <span class="rounded-full border border-border bg-card px-3 py-1.5">纯静态架构</span>
    </div>
  </PageHeader>

  <div class="shell max-w-5xl py-10 sm:py-12">
    <div class="grid gap-5 lg:grid-cols-2">
      <section class="surface-card p-5 sm:p-6">
        <h2 class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-accent-soft text-accent">
            <Check className="h-4 w-4" aria-hidden="true" />
          </span>
          本站做什么
        </h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-muted-foreground">
          {does.map((item) => (
            <li class="flex items-start gap-2.5">
              <Check className="mt-1 h-3.5 w-3.5 shrink-0 text-accent" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="surface-card p-5 sm:p-6">
        <h2 class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-muted text-muted-foreground">
            <X className="h-4 w-4" aria-hidden="true" />
          </span>
          本站不做什么
        </h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-muted-foreground">
          {doesNot.map((item) => (
            <li class="flex items-start gap-2.5">
              <X className="mt-1 h-3.5 w-3.5 shrink-0 text-muted-foreground" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="mt-5 grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="surface-card p-5 sm:p-6">
        <h2 class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight">
          <ShieldCheck className="h-5 w-5 text-accent" aria-hidden="true" />
          安装之前
        </h2>
        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          插件由第三方作者独立维护。安装前请检查源代码、许可证与安全性；目录收录不代表任何安全保证。
        </p>
      </section>

      <section class="surface-card p-5 sm:p-6">
        <h2 class="font-display text-lg font-semibold tracking-tight">参与贡献</h2>
        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          目录条目是 <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px] text-foreground">src/data/plugins/</code>
          中的 TypeScript 数据文件。提交条目后重新构建即可，无需数据库或后台。
        </p>
        <a
          href="https://github.com/phil616/dsh-plugin-market"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-accent-foreground transition-opacity duration-150 hover:opacity-90"
        >
          <FolderGit2 className="h-4 w-4" aria-hidden="true" />
          查看源代码
        </a>
      </section>
    </div>

    <section class="mt-5 flex items-start gap-3 rounded-2xl border border-border bg-surface/45 p-5 text-sm leading-6 text-muted-foreground">
      <BookOpen className="mt-0.5 h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
      <div>
        <h2 class="font-semibold text-foreground">免责声明</h2>
        <p class="mt-1">
          所有插件均由各自作者提供和维护。本站只展示公开信息，不托管、下载或执行插件。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
