---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { plugins } from "@/data/plugins";
import { getAllTags } from "@/utils/plugin";
import { BookOpen, Check, FolderGit2, X } from "lucide-react";

const tagCount = getAllTags(plugins).length;

const does = [
  "发现与浏览 Harness 插件",
  "按名称、描述、标签或作者搜索",
  "按标签筛选并排序目录",
  "解释每个插件的用途",
  "链接到作者的原始仓库",
  "复制安装命令，供您在终端中执行",
];

const doesNot = [
  "托管或存储插件文件",
  "下载、镜像或代理插件",
  "安装或执行任何程序",
  "管理账户或评分",
  "运行后端、数据库或 API",
];
---

<BaseLayout
  title="关于 — DeepSeek Harness插件市场"
  description="DeepSeek Harness插件市场（DSH插件市场）是一个插件目录。它展示、介绍并链接 Harness 插件——从不托管、下载或执行它们。"
>
  <div class="shell max-w-3xl py-14 sm:py-16">
    <p class="font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-accent">关于</p>
    <h1 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      关于 DeepSeek Harness插件市场
    </h1>

    <div class="mt-8 space-y-8 leading-relaxed text-muted-foreground">
      <section>
        <p>
          DeepSeek Harness插件市场（简称 DSH插件市场）是面向 DeepSeek Harness
          智能体的插件目录——目前收录了{" "}
          {plugins.length} 个插件、覆盖 {tagCount} 个标签。它帮助你回答三个问题：
          <em>有哪些插件</em>、<em>每个插件是做什么的</em>，以及{" "}
          <em>如何安装</em>。
        </p>
      </section>

      <section>
        <h2 class="font-display text-lg font-semibold tracking-tight text-foreground">
          本站做什么
        </h2>
        <ul class="mt-3 space-y-2">
          {does.map((item) => (
            <li class="flex items-start gap-2.5">
              <Check className="mt-0.5 h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-display text-lg font-semibold tracking-tight text-foreground">
          本站不做什么
        </h2>
        <ul class="mt-3 space-y-2">
          {doesNot.map((item) => (
            <li class="flex items-start gap-2.5">
              <X className="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4">
          这是一个 <strong class="text-foreground">纯静态网站</strong>——只有
          HTML、CSS 和少量 JavaScript。没有后端、没有数据库、没有 API。插件文件始终存放在作者自己的
          GitHub、Gitea、npm 或其他地址。
        </p>
      </section>

      <section>
        <h2 class="font-display text-lg font-semibold tracking-tight text-foreground">
          安装之前
        </h2>
        <p>
          插件由第三方作者独立维护。安装任何插件之前，请先检查其源代码、许可证与安全性。
          本目录的收录<em>不</em>代表对插件安全性的任何保证。
        </p>
      </section>

      <section>
        <h2 class="font-display text-lg font-semibold tracking-tight text-foreground">
          参与贡献
        </h2>
        <p>
          目录条目直接保存在源码仓库中，是{" "}
          <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px] text-foreground">src/data/plugins/</code>{" "}
          下的纯 TypeScript 数据文件。新增一个插件只需改动一个文件，然后执行{" "}
          <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px] text-foreground">npm run build</code>{" "}
          重新构建即可。
        </p>
        <a
          href="https://code.altasci.com/phil616/deepseek-harness-market"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded-lg bg-foreground px-4 py-2 text-sm font-medium text-background transition-colors duration-150 hover:bg-accent hover:text-white dark:hover:text-black"
        >
          <FolderGit2 className="h-4 w-4" aria-hidden="true" />
          查看源代码
        </a>
      </section>

      <section class="rounded-xl border border-border bg-card p-5">
        <h2 class="flex items-center gap-2 font-display text-sm font-semibold tracking-tight text-foreground">
          <BookOpen className="h-4 w-4 text-accent" aria-hidden="true" />
          免责声明
        </h2>
        <p class="mt-2 text-sm leading-relaxed">
          DSH插件市场收录的所有插件均由各自的作者提供和维护。本站展示不代表对插件安全性的保证，
          安装前请自行检查插件的源代码、许可证与安全性。
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
