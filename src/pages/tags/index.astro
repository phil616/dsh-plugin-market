---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { plugins } from "@/data/plugins";
import { getAllTags, getPluginsByTag, tagLabel } from "@/utils/plugin";
import { ArrowUpRight, Hash } from "lucide-react";

const tagCounts = getAllTags(plugins).map((tag) => ({
  tag,
  count: getPluginsByTag(plugins, tag).length,
}));
---

<BaseLayout
  title="标签 — DeepSeek Harness插件市场"
  description="按标签浏览 Harness 插件：搜索、记忆、MCP、开发者、自动化、数据库等。"
>
  <PageHeader
    eyebrow="分类浏览"
    title="全部标签"
    description="从主题、能力和使用场景出发，快速找到适合的 Harness 插件。"
  />
  <div class="shell py-10 sm:py-12">
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tagCounts.map(({ tag, count }) => (
        <li>
          <a
            href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
            class="group surface-card flex min-h-20 items-center gap-3 p-4 transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-accent/45 hover:shadow-md"
          >
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
              <Hash className="h-4 w-4" aria-hidden="true" />
            </span>
            <span class="min-w-0">
              <span class="block font-display text-sm font-semibold transition-colors group-hover:text-accent">
                {tagLabel(tag)}
              </span>
              <span class="mt-0.5 block text-xs text-muted-foreground">{count} 个插件</span>
            </span>
            <ArrowUpRight
              className="ml-auto h-4 w-4 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
