---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { plugins } from "@/data/plugins";
import { getAllTags, getPluginsByTag, tagLabel } from "@/utils/plugin";

const tagCounts = getAllTags(plugins).map((tag) => ({
  tag,
  count: getPluginsByTag(plugins, tag).length,
}));
---

<BaseLayout
  title="标签 — DeepSeek Harness插件市场"
  description="按标签浏览 Harness 插件：搜索、记忆、MCP、开发者、自动化、数据库等。"
>
  <div class="shell py-14 sm:py-16">
    <p class="font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-accent">分类</p>
    <h1 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">全部标签</h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">
      目录中使用的全部标签。点击任意标签即可查看对应的插件。
    </p>

    <ul class="mt-8 flex flex-wrap gap-2">
      {tagCounts.map(({ tag, count }) => (
        <li>
          <a
            href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
            class="group inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors duration-150 hover:border-accent/60 hover:text-foreground"
          >
            {tagLabel(tag)}
            <span class="rounded-full bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground transition-colors duration-150 group-hover:bg-accent-soft group-hover:text-accent">
              {count}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
