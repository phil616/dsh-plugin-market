---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PluginGrid from "@/components/PluginGrid.astro";
import { plugins } from "@/data/plugins";
import { getAllTags, getPluginsByTag, sortPlugins, tagLabel } from "@/utils/plugin";

export function getStaticPaths() {
  return getAllTags(plugins).map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;

const tagPlugins = sortPlugins(getPluginsByTag(plugins, tag), "featured");

const site = Astro.site ?? new URL("https://harness-plugins.example.com");
const canonical = new URL(`/tags/${encodeURIComponent(tag.toLowerCase())}/`, site).href;
---

<BaseLayout
  title={`${tagLabel(tag)}插件 — DeepSeek Harness插件市场`}
  description={`${tagPlugins.length} 个 Harness 插件标记为“${tagLabel(tag)}”。查看它们的介绍、标签、安装命令与仓库链接。`}
  canonical={canonical}
>
  <PageHeader
    eyebrow="标签"
    title={tagLabel(tag)}
    description={`共有 ${tagPlugins.length} 个插件标记为“${tagLabel(tag)}”。`}
  >
    <a
      slot="before"
      href="/tags"
      class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors duration-150 hover:text-accent"
    >
      ← 返回全部标签
    </a>
  </PageHeader>
  <div class="shell py-10 sm:py-12">
    <div>
      <PluginGrid plugins={tagPlugins} cols={3} />
    </div>
  </div>
</BaseLayout>
