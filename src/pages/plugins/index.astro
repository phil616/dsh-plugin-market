---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PluginGrid from "@/components/PluginGrid.astro";
import { plugins } from "@/data/plugins";
import { sortPlugins } from "@/utils/plugin";

const sorted = sortPlugins(plugins, "featured");
---

<BaseLayout
  title="全部插件 — DeepSeek Harness插件市场"
  description="浏览目录中的全部插件——设计工具、AI 技能与集成等，支持 DeepSeek Harness 原生运行。"
>
  <div class="shell py-14 sm:py-16">
    <p class="font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-accent">插件目录</p>
    <h1 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">全部插件</h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">
      目录中的全部条目。精选插件排在前面，其余按名称字母顺序排列。
    </p>

    <div class="mt-8">
      <PluginGrid plugins={sorted} cols={3} />
    </div>
  </div>
</BaseLayout>
