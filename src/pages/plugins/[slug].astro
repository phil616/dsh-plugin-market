---
import PluginLayout from "@/layouts/PluginLayout.astro";
import TagBadge from "@/components/TagBadge.astro";
import InstallPanel from "@/components/InstallBox";
import { plugins } from "@/data/plugins";
import type { Plugin } from "@/types/plugin";
import {
  ArrowLeft,
  BookOpen,
  ExternalLink,
  FolderGit2,
  Globe,
  Link2,
  ShieldAlert,
  Terminal,
  User,
} from "lucide-react";

export function getStaticPaths() {
  return plugins.map((plugin) => ({
    params: { slug: plugin.slug },
    props: { plugin },
  }));
}

interface Props {
  plugin: Plugin;
}

const { plugin } = Astro.props;

const deprecated = plugin.deprecated ?? false;

const externalLinks = [
  { name: "仓库", href: plugin.repository, icon: FolderGit2 },
  { name: "主页", href: plugin.homepage, icon: Globe, show: Boolean(plugin.homepage) },
  { name: "文档", href: plugin.documentation, icon: BookOpen, show: Boolean(plugin.documentation) },
].filter((l) => l.show !== false);

const linkRows = [
  { name: "仓库", href: plugin.repository, icon: FolderGit2 },
  ...(plugin.homepage ? [{ name: "主页", href: plugin.homepage, icon: Globe }] : []),
  ...(plugin.documentation ? [{ name: "文档", href: plugin.documentation, icon: BookOpen }] : []),
  ...(plugin.author.url ? [{ name: `作者 — ${plugin.author.name}`, href: plugin.author.url, icon: User }] : []),
  ...(plugin.links ?? []).map((l) => ({ name: l.name, href: l.url, icon: Link2 })),
];
---

<PluginLayout plugin={plugin}>
  <div class="shell py-8 sm:py-12">
    <a
      href="/plugins"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors duration-150 hover:text-accent"
    >
      <ArrowLeft className="h-4 w-4" aria-hidden="true" />
      全部插件
    </a>

    <!-- Header card -->
    <div class="surface-card relative mt-6 overflow-hidden p-5 before:absolute before:inset-x-0 before:top-0 before:h-1 before:bg-accent sm:p-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="font-display text-2xl font-bold tracking-[-0.035em] sm:text-3xl">{plugin.name}</h1>
              {plugin.example && (
                <span class="rounded-md border border-accent/35 bg-accent-soft/70 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-accent">
                  示例
                </span>
              )}
              {deprecated && (
                <span class="rounded border border-red-400/50 bg-red-500/10 px-1.5 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider text-red-500 dark:text-red-400">
                  已弃用
                </span>
              )}
            </div>
            <p class="mt-2 max-w-xl text-[15px] leading-7 text-muted-foreground">{plugin.description}</p>
            <div class="mt-4 flex flex-wrap items-center gap-1.5">
              {plugin.tags.map((t) => (
                <TagBadge tag={t} />
              ))}
            </div>
            <p class="mt-4 text-sm text-muted-foreground">
              作者{" "}
              <a
                href={plugin.author.url ?? plugin.repository}
                target="_blank"
                rel="noopener noreferrer"
                class="link-accent font-medium"
              >
                {plugin.author.name}
              </a>
              {plugin.license && (
                <>
                  {" · "}
                  <span class="font-mono text-xs">{plugin.license}</span>
                </>
              )}
            </p>
        </div>

        <div class="flex flex-wrap gap-2 lg:shrink-0">
          {externalLinks.map((l) => {
            const Icon = l.icon;
            return (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class={
                  l.name === "仓库"
                    ? "inline-flex items-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-accent-foreground shadow-sm transition-opacity duration-150 hover:opacity-90"
                    : "inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-semibold text-muted-foreground shadow-sm transition-colors duration-150 hover:border-accent/50 hover:text-foreground"
                }
              >
                <Icon className="h-4 w-4" aria-hidden="true" />
                {l.name}
                <ExternalLink className="h-3.5 w-3.5 opacity-60" aria-hidden="true" />
              </a>
            );
          })}
        </div>
      </div>
    </div>

    {
      deprecated && (
        <div class="mt-6 flex items-start gap-3 rounded-2xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-6 text-amber-800 dark:text-amber-300">
          <ShieldAlert className="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
          <p>
            该插件已不再积极维护。它保留在目录中供参考——请到仓库中查看 fork
            或替代方案。
          </p>
        </div>
      )
    }

    <div class="mt-8 grid min-w-0 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-8">
      <div class="min-w-0 space-y-6">
        <!-- 插件介绍 -->
        <section class="surface-card min-w-0 overflow-hidden p-5 sm:p-6">
          <p class="page-eyebrow">概览</p>
          <h2 class="mt-2 font-display text-xl font-semibold tracking-tight">插件介绍</h2>
          <p class="mt-4 whitespace-pre-line text-[15px] leading-7 text-muted-foreground">
            {plugin.longDescription ?? plugin.description}
          </p>
        </section>

        <!-- 安装 -->
        <section class="surface-card min-w-0 overflow-hidden p-5 sm:p-6">
          <h2 class="flex items-center gap-2.5 font-display text-xl font-semibold tracking-tight">
            <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-accent-soft text-accent">
              <Terminal className="h-4 w-4" aria-hidden="true" />
            </span>
            安装
          </h2>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-muted-foreground">
            请在自己的终端中执行这些命令。本站只负责展示与复制，不会代您执行任何内容。
          </p>
          <div class="mt-5">
            <InstallPanel client:load methods={plugin.installMethods} />
          </div>
        </section>
      </div>

      <!-- 相关链接 -->
      <aside class="surface-card overflow-hidden lg:sticky lg:top-24">
        <div class="border-b border-border bg-surface/45 px-4 py-3.5">
          <h2 class="font-display text-sm font-semibold tracking-tight">相关链接</h2>
        </div>
        <ul class="divide-y divide-border">
          {linkRows.map((l) => {
            const Icon = l.icon;
            return (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-3 px-4 py-3.5 transition-colors duration-150 hover:bg-accent-soft/35"
                >
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-surface text-muted-foreground transition-colors group-hover:bg-accent-soft group-hover:text-accent">
                    <Icon className="h-4 w-4" aria-hidden="true" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-semibold">{l.name}</span>
                    <span class="mt-0.5 block truncate font-mono text-[10px] text-muted-foreground">
                      {l.href.replace(/^https?:\/\//, "")}
                    </span>
                  </span>
                  <ExternalLink
                    className="h-3.5 w-3.5 shrink-0 text-muted-foreground transition-colors duration-150 group-hover:text-accent"
                    aria-hidden="true"
                  />
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    </div>
  </div>
</PluginLayout>
